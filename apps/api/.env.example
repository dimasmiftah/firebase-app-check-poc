# Firebase Admin SDK (service account JSON: project_id, client_email, private_key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; escaped \n sequences are supported
FIREBASE_PRIVATE_KEY=""

# Firebase Web App IDs (format 1:1234567890:web:abcdef) allowed to call the API
FIREBASE_RECAPTCHA_APP_ID=
FIREBASE_CLOUDFLARE_APP_ID=

# Cloudflare Turnstile secret key (never expose to the frontend)
TURNSTILE_SECRET_KEY=
# Hostname Cloudflare must report for the solved widget
TURNSTILE_EXPECTED_HOSTNAME=localhost
# Optional: require this Turnstile action (must match NEXT_PUBLIC_TURNSTILE_ACTION)
TURNSTILE_EXPECTED_ACTION=

# TTL (minutes) of App Check tokens minted by the exchange endpoint (30 min - 7 days)
APP_CHECK_TTL_MINUTES=30

PORT=3001
CORS_ORIGIN=http://localhost:3000

# Max token exchanges per client per minute
EXCHANGE_RATE_LIMIT_PER_MINUTE=60
