# Firebase project (Project settings > General > Your apps > SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Web App A (reCAPTCHA Enterprise): App ID looks like 1:123:web:abc
NEXT_PUBLIC_RECAPTCHA_APP_ID=
# reCAPTCHA Enterprise score-based site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Firebase Web App B (Cloudflare custom provider)
NEXT_PUBLIC_CLOUDFLARE_APP_ID=
# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Turnstile action; must equal TURNSTILE_EXPECTED_ACTION on the API
NEXT_PUBLIC_TURNSTILE_ACTION=

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
